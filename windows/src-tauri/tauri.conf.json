{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XNook",
  "version": "0.3.2",
  "identifier": "top.imagentx.xnook.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "node scripts/build-inputs.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "XNook",
        "width": 300,
        "height": 52,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "音乐、歌词、日历、笔记与文件的桌面浮岛",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/ICAL.js-LICENSE.txt": "licenses/ICAL.js-LICENSE.txt",
      "../licenses/drag-APACHE.txt": "licenses/drag-APACHE.txt",
      "../licenses/drag-MIT.txt": "licenses/drag-MIT.txt",
      "../licenses/gif-APACHE.txt": "licenses/gif-APACHE.txt",
      "../licenses/gif-MIT.txt": "licenses/gif-MIT.txt",
      "../licenses/winvd-MIT.txt": "licenses/winvd-MIT.txt",
      "../licenses/unicode-normalization-LICENSE-UNICODE.txt": "licenses/unicode-normalization-LICENSE-UNICODE.txt",
      "../licenses/unicode-normalization-LICENSE-APACHE.txt": "licenses/unicode-normalization-LICENSE-APACHE.txt",
      "../licenses/unicode-normalization-LICENSE-MIT.txt": "licenses/unicode-normalization-LICENSE-MIT.txt",
      "../licenses/regex-LICENSE-APACHE.txt": "licenses/regex-LICENSE-APACHE.txt",
      "../licenses/regex-LICENSE-MIT.txt": "licenses/regex-LICENSE-MIT.txt"
    }
  }
}
